// Cloudflare Workers static assets: serves the Hugo build in ./public.
// Same file for every customer site; new-site.sh will fill in name and domains.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simplifymy-biz",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    // Serve public/404.html with a 404 status for unknown paths.
    "not_found_handling": "404-page"
  },
  // Custom domains: Cloudflare creates the DNS records and HTTPS certificates.
  "routes": [
    { "pattern": "simplifymy.biz", "custom_domain": true },
    { "pattern": "www.simplifymy.biz", "custom_domain": true }
  ],
  // No workers.dev preview address; the site only answers on its own domain.
  "workers_dev": false
}
